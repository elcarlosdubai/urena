{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/citas",
      "destination": "/cita"
    },
    {
      "source": "/citas/(.*)",
      "destination": "/cita"
    },
    {
      "source": "/cita/(.*)",
      "destination": "/cita"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/about",
      "destination": "/"
    },
    {
      "source": "/services",
      "destination": "/"
    },
    {
      "source": "/services/(.*)",
      "destination": "/"
    },
    {
      "source": "/:path((?!api/|assets/|cita/|citas/|admin/|\\.well-known/|llms\\.txt|favicon\\.svg|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
